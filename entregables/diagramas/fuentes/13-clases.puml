@startuml 13-clases
!include estilo.iuml
title Diagrama de clases — Las entidades principales y cómo se relacionan
hide empty members
skinparam class {
  BackgroundColor #F7F9FC
  BorderColor #1B2A41
}

class Usuario {
  nombre
  correo
  rol (cliente, operador, domiciliario)
  registrarse()
  iniciarSesion()
}
class Consentimiento {
  propósito (datos personales, biometría)
  fecha
  revocado
}
class Hub {
  nombre
  zona
  capacidad
  puntos de carga
}
class Vehiculo {
  tipo (patineta, bicicleta, dron)
  modo (alquiler o venta)
  estado
  batería
  ubicación
  reportarPosicion()
}
class Reserva {
  modalidad (hub o domicilio)
  estado
  dirección
  iniciar()
  terminar()
  cancelar()
}
class Compra {
  precio
  estado
}
class Pago {
  monto
  referencia
  aprobado o rechazado
}
class Entrega {
  hora límite
  estado
  causa del retraso
}
class Alerta {
  tipo (sin casco, caída,\nsin GPS, batería baja)
  fecha
}
class SesionDesbloqueo {
  paso (QR, casco, listo)
  vence en 2 minutos
}

interface FuenteDeDatos <<interfaz>> {
  listarVehiculos()
  reservar()
  pagar()
}
class DatosDePrueba
class DatosDelServidor

interface ReglaDeSeguridad <<interfaz>> {
  evaluar(vehículo)
}
class SinCasco
class Caida
class SinGPS
class BateriaBaja

Usuario "1" --> "*" Consentimiento : otorga
Usuario "1" --> "*" Reserva : hace
Usuario "1" --> "*" Compra : hace
Hub "1" o-- "*" Vehiculo : aloja
Vehiculo "1" --> "*" Reserva : se reserva en
Vehiculo "1" --> "0..1" Compra : se vende en
Reserva "1" --> "*" Pago : genera
Compra "1" --> "*" Pago : genera
Reserva "1" --> "0..1" Entrega : si es a domicilio
Usuario "1" --> "*" Entrega : la realiza (domiciliario)
Reserva "1" --> "*" SesionDesbloqueo : abre
Vehiculo "1" --> "*" Alerta : genera

FuenteDeDatos <|.. DatosDePrueba
FuenteDeDatos <|.. DatosDelServidor
ReglaDeSeguridad <|.. SinCasco
ReglaDeSeguridad <|.. Caida
ReglaDeSeguridad <|.. SinGPS
ReglaDeSeguridad <|.. BateriaBaja
ReglaDeSeguridad ..> Alerta : produce

note bottom of FuenteDeDatos
  Polimorfismo: las pantallas usan la interfaz
  y no saben si los datos son de prueba o reales.
end note
@enduml
