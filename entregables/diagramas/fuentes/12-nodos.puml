@startuml 12-nodos
!pragma layout elk
!include estilo.iuml
title Diagrama de nodos — Dispositivos, servidores y cómo se comunican
left to right direction
skinparam packageStyle folder
skinparam node {
  BackgroundColor #F7F9FC
  BorderColor #1B2A41
}

' ================= DISPOSITIVOS =================
node "Celular del usuario" <<dispositivo>> as celU #E8F1FB {
  node "Navegador móvil" as navU {
    artifact "App web (landing, mapa,\nreservas, pago)" as appU
    artifact "Modelo de IA de casco\n+ cámara" as onnx
  }
}
node "Computador del usuario" <<dispositivo>> as pcU #E8F1FB {
  node "Navegador de escritorio" as navPc {
    artifact "App web" as appPc
  }
}
node "Celular del domiciliario" <<dispositivo>> as celD #E8F1FB {
  node "Navegador móvil " as navD {
    artifact "App de entregas\n(/entregas)" as appD
  }
}
node "Computador del operador" <<dispositivo>> as pcO #E8F1FB {
  node "Navegador de escritorio " as navO {
    artifact "Panel de administración\n(/admin)" as appO
  }
}
node "Vehículo alquilado (patineta, bici, dron)" <<dispositivo>> as veh #FDEBD0 {
  node "Dispositivo IoT (uno por vehículo)" <<dispositivo>> as iot {
    artifact "GPS + batería + sensor de caída\n+ lector de casco + candado\n(simulado por ahora)" as sensores
  }
}

' ================= SERVIDOR (VM) =================
node "Máquina virtual Azure (Ubuntu 24.04)" <<servidor>> as vm #E9F7EC {
  node "Nginx (HTTPS 443, Let's Encrypt)" as nginx {
    artifact "Proxy inverso\n+ certificado" as proxy
  }
  node "Servicio umh (Node 24, puerto 8080)" as svc {
    artifact "Pantallas (SSR) + API /api/*" as api
    artifact "Eventos en vivo (SSE)\n+ simulador de flota" as sse
    artifact "Cliente de pagos Bold\n+ receptor de webhook" as boldsvc
  }
  database "SQLite (umh.db)" as db
}

' ================= TERCEROS =================
node "Servicios de terceros" as terceros #F3E8FB {
  cloud "Bold (pasarela de pagos)\nllaves de prueba" as bold #F3E8FB {
    node "API de links de pago" as boldapi
    node "Checkout de Bold" as checkout
  }
  node "Brevo (correo)" as brevo
  node "OpenStreetMap (mapas)" as osm
}
node "GitHub (CI/CD)" <<tercero>> as gh #EEEEEE

' ================= COMUNICACIÓN =================
appU --> proxy : HTTPS\npáginas + REST
appPc --> proxy : HTTPS
appD --> proxy : HTTPS
appO --> proxy : HTTPS
proxy --> api : HTTP local\n127.0.0.1:8080
api --> db : SQL (node:sqlite)
sse ..> appU : SSE (eventos en vivo)
sse ..> appO : SSE (alertas)
sensores --> proxy : HTTPS\nPOST /api/ingest (telemetría)\nrecibe orden de desbloqueo
onnx -[hidden]- appU

boldsvc --> boldapi : HTTPS\nPOST /online/link/v1
appU ..> checkout : redirección HTTPS\n(pagar)
checkout ..> appU : vuelve a\n/pago/resultado
checkout ..> proxy : webhook HTTPS firmado\nPOST /api/payments/bold/webhook
api --> brevo : API HTTPS\n(avisos de retraso)
appU --> osm : HTTPS\n(mosaicos de mapa)
gh ..> vm : scp + systemctl\n(despliegue manual)

legend right
  Línea continua = comunicación directa.
  Línea punteada = redirección, evento o aviso.
  Los dispositivos nunca hablan con Bold ni con la base de datos:
  todo pasa por el servicio umh. Bold solo avisa por el webhook firmado.
endlegend
@enduml
