@startuml 25-clases-bce
!include estilo.iuml
title Diagrama de clases BCE — Interfaces → Controladores → Entidades
top to bottom direction
skinparam nodesep 35
skinparam ranksep 70
skinparam packageStyle folder
skinparam packageTitleFontSize 14
skinparam defaultTextAlignment center
skinparam boundary {
  BackgroundColor #CFE3F7
  BorderColor #2F6DB5
  FontSize 12
}
skinparam control {
  BackgroundColor #D4EFD8
  BorderColor #2E8B3E
  FontSize 12
}
skinparam entity {
  BackgroundColor #FBE3C2
  BorderColor #C47312
  FontSize 12
}

' ================= Actores =================

package "0. ENTRADA — lo primero que ve cualquier persona" as L #E8F1FB {
  boundary "**PantallaLanding (/)**\n<size:10>verTarifas()</size>\n<size:10>irARegistro()</size>\n<size:10>irALaApp()</size>" as PantallaLanding
}

package "1. INTERFACES (Boundary) — lo que ve cada persona después de la landing" as B #F4F8FD {
  boundary "**PantallaRegistroLogin**\n<size:10>pedirDatos()</size>\n<size:10>mostrarError()</size>" as PantallaRegistroLogin
  boundary "**PantallaCatalogo**\n<size:10>listarVehiculos()</size>\n<size:10>confirmarCompra()</size>" as PantallaCatalogo
  boundary "**PantallaMapaAlquiler**\n<size:10>mostrarFlota()</size>\n<size:10>elegirModalidad()</size>" as PantallaMapaAlquiler
  boundary "**PantallaMisReservas**\n<size:10>verReservas()</size>\n<size:10>terminarViaje()</size>" as PantallaMisReservas
  boundary "**PantallaResultadoPago**\n<size:10>consultarEstado()</size>\n<size:10>reintentar()</size>" as PantallaResultadoPago
  boundary "**PantallaDesbloqueo**\n<size:10>escanearQR()</size>\n<size:10>mostrarCasco()</size>\n<size:10>iniciarViaje()</size>" as PantallaDesbloqueo
  boundary "**PanelOperador**\n<size:10>verIndicadores()</size>\n<size:10>simularEvento()</size>\n<size:10>editarCatalogo()</size>\n<size:10>asignarEntrega()</size>" as PanelOperador
  boundary "**BandejaDomiciliario**\n<size:10>verEntregas()</size>\n<size:10>confirmarEntrega()</size>\n<size:10>marcarTardia()</size>" as BandejaDomiciliario
}

package "2. CONTROLADORES (Control) — aplican las reglas del negocio" as C #F3FAF4 {
  control "**ControlAutenticacion**\n<size:10>registrar()</size>\n<size:10>iniciarSesion()</size>\n<size:10>cerrarSesion()</size>" as ControlAutenticacion
  control "**ControlCompra**\n<size:10>comprar(vehiculo)</size>" as ControlCompra
  control "**ControlPago**\n<size:10>pagar(monto)</size>\n<size:10>calcularCostoViaje()</size>\n<size:10>consultarOrden()</size>" as ControlPago
  control "**ControlWebhookBold**\n<size:10>validarFirma()</size>\n<size:10>confirmarPago()</size>" as ControlWebhookBold
  control "**ControlReserva**\n<size:10>reservar(vehiculo, modalidad)</size>\n<size:10>cancelar()</size>\n<size:10>terminarViaje()</size>" as ControlReserva
  control "**ControlDesbloqueo**\n<size:10>abrirSesion()</size>\n<size:10>validarQR()</size>\n<size:10>validarCasco()</size>\n<size:10>validarRostro()</size>" as ControlDesbloqueo
  control "**ControlCatalogo**\n<size:10>guardarVehiculo()</size>\n<size:10>guardarHub()</size>\n<size:10>retirar()</size>" as ControlCatalogo
  control "**ControlAlertas**\n<size:10>evaluarLectura()</size>\n<size:10>limpiarAlerta()</size>" as ControlAlertas
  control "**ControlEntregas**\n<size:10>asignar()</size>\n<size:10>entregar()</size>\n<size:10>marcarTardia()</size>" as ControlEntregas
}

package "3. ENTIDADES (Entity) — la información que se guarda" as E #FFFAF0 {
  entity "**Usuario**\n<size:10>nombre, correo, rol</size>" as Usuario
  entity "**Consentimiento**\n<size:10>propósito, fecha</size>" as Consentimiento
  entity "**Compra**\n<size:10>precio, estado</size>" as Compra
  entity "**Pago**\n<size:10>monto, referencia</size>" as Pago
  entity "**OrdenBold**\n<size:10>link, estado, vence</size>" as OrdenBold
  entity "**Reserva**\n<size:10>modalidad, estado</size>" as Reserva
  entity "**SesionDesbloqueo**\n<size:10>paso, vence</size>" as SesionDesbloqueo
  entity "**Vehiculo**\n<size:10>tipo, modo,</size>\n<size:10>estado, batería</size>" as Vehiculo
  entity "**Hub**\n<size:10>nombre, capacidad</size>" as Hub
  entity "**Alerta**\n<size:10>tipo, fecha</size>" as Alerta
  entity "**Entrega**\n<size:10>horaLimite, estado</size>" as Entrega
}

package "4. INTERFACES CON SISTEMAS EXTERNOS (Boundary)" as X #F4F8FD {
  boundary "**InterfazPasarelaPagos**\n<size:10>(Bold; simulada sin llaves)</size>\n<size:10>crearLinkDePago(monto)</size>\n<size:10>consultarLink()</size>" as InterfazPasarelaPagos
  boundary "**InterfazVehiculo**\n<size:10>recibirLectura()</size>\n<size:10>enviarDesbloqueo()</size>" as InterfazVehiculo
  boundary "**DispositivoIoT**\n<size:10>(uno en cada vehículo alquilado)</size>\n<size:10>GPS, batería, sensor de caída,</size>\n<size:10>lector de casco</size>" as DispositivoIoT
  boundary "**InterfazCorreo**\n<size:10>enviarAviso()</size>" as InterfazCorreo
}

' --- orden de izquierda a derecha en cada capa (alinea columnas y evita cruces) ---
PantallaRegistroLogin -[hidden]right- PantallaCatalogo
PantallaCatalogo -[hidden]right- PantallaMapaAlquiler
PantallaMapaAlquiler -[hidden]right- PantallaMisReservas
PantallaMisReservas -[hidden]right- PantallaResultadoPago
PantallaResultadoPago -[hidden]right- PantallaDesbloqueo
PantallaDesbloqueo -[hidden]right- PanelOperador
PanelOperador -[hidden]right- BandejaDomiciliario
ControlAutenticacion -[hidden]right- ControlCompra
ControlCompra -[hidden]right- ControlPago
ControlPago -[hidden]right- ControlWebhookBold
ControlWebhookBold -[hidden]right- ControlReserva
ControlReserva -[hidden]right- ControlDesbloqueo
ControlDesbloqueo -[hidden]right- ControlCatalogo
ControlCatalogo -[hidden]right- ControlAlertas
ControlAlertas -[hidden]right- ControlEntregas
Usuario -[hidden]right- Consentimiento
Consentimiento -[hidden]right- Compra
Compra -[hidden]right- Pago
Pago -[hidden]right- OrdenBold
OrdenBold -[hidden]right- Reserva
Reserva -[hidden]right- SesionDesbloqueo
SesionDesbloqueo -[hidden]right- Vehiculo
Vehiculo -[hidden]right- Hub
Hub -[hidden]right- Alerta
Alerta -[hidden]right- Entrega
InterfazPasarelaPagos -[hidden]right- InterfazVehiculo
InterfazVehiculo -[hidden]right- DispositivoIoT
DispositivoIoT -[hidden]right- InterfazCorreo
Entrega -[hidden]down- InterfazPasarelaPagos

' --- Actores -> Interfaces ---

' --- la landing no toca controladores: solo lleva a las demás pantallas ---
PantallaLanding --> PantallaRegistroLogin : "Crear cuenta / Entrar"
PantallaLanding --> PantallaCatalogo : "Ver catálogo"
PantallaLanding --> PantallaMapaAlquiler : "Ver la app"
PantallaRegistroLogin ..> PanelOperador : si es operador
PantallaRegistroLogin ..> BandejaDomiciliario : si es domiciliario
PantallaMapaAlquiler ..> PantallaMisReservas : sus reservas
PantallaMapaAlquiler ..> PantallaDesbloqueo : desbloquear

' --- Interfaces -> Controladores ---
PantallaResultadoPago --> ControlPago
PantallaRegistroLogin --> ControlAutenticacion
PantallaCatalogo --> ControlCompra
PantallaMapaAlquiler --> ControlReserva
PantallaMisReservas --> ControlReserva
PantallaDesbloqueo --> ControlDesbloqueo
PanelOperador --> ControlCatalogo
PanelOperador --> ControlAlertas
PanelOperador --> ControlEntregas
BandejaDomiciliario --> ControlEntregas

' --- entre controladores (punteado, misma fila) ---
ControlCompra .right.> ControlPago : incluye pagar
ControlReserva .left.> ControlPago : incluye pagar

' --- Controladores -> Entidades ---
ControlAutenticacion --> Usuario
ControlAutenticacion --> Consentimiento
ControlCompra --> Compra
ControlPago --> Pago
ControlPago --> OrdenBold
ControlWebhookBold --> OrdenBold
ControlWebhookBold --> Pago
ControlReserva --> Reserva
ControlDesbloqueo --> SesionDesbloqueo
ControlCatalogo --> Vehiculo
ControlCatalogo --> Hub
ControlAlertas --> Alerta
ControlEntregas --> Entrega

' --- Controladores -> sistemas externos (punteado, hacia abajo) ---
ControlPago .[norank].> InterfazPasarelaPagos : crea link de pago
InterfazPasarelaPagos ..> ControlWebhookBold : avisa el resultado (webhook)
ControlDesbloqueo .[norank].> InterfazVehiculo : desbloquea
DispositivoIoT ..> InterfazVehiculo : telemetría y candado
InterfazVehiculo ..> ControlAlertas : envía lecturas
ControlEntregas ..> InterfazCorreo : avisa retraso

note right of L
  Orden de llegada: el visitante cae primero en la Landing (/).
  Solo después se registra, inicia sesión y entra a la app.
  Con Bold, tras pagar vuelve a PantallaResultadoPago.
end note

legend bottom
  |= Símbolo |= Capa |= Regla |
  | círculo con línea en T | Interfaz (Boundary) | la persona entra por la landing y solo habla con interfaces; las interfaces solo hablan con controladores |
  | círculo con flecha | Controlador (Control) | aplica las reglas; usa entidades y servicios externos |
  | círculo subrayado | Entidad (Entity) | guarda datos; no conoce las pantallas |
  Flecha continua = usa.  Flecha punteada = pide un servicio.
  Una interfaz nunca toca una entidad directamente.
  Las relaciones entre entidades (1 a muchos) están en el diagrama 14.
endlegend
@enduml
