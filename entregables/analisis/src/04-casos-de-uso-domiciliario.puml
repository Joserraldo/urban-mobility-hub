@startuml 04-casos-de-uso-domiciliario
!include ../../_tools/uml-style.iuml
left to right direction
title Casos de uso del DOMICILIARIO (repartidor que lleva el vehículo al cliente)

actor Cliente as C
actor Domiciliario as D
D --|> C

rectangle "Sistema UMH" {
  usecase "UC02 Iniciar o\ncerrar sesión" as UC02 #FFF4CC
  usecase "UC15 Ver entregas asignadas" as UC15 #FDF0E4
  usecase "UC16 Realizar entrega\nde vehículo" as UC16 #FDF0E4
  usecase "UC17 Marcar entrega tardía" as UC17 #FDF0E4
  usecase "UC19 Notificar retraso\npor correo" as UC19 #F0EBFA
}

actor "API de correo\n(Brevo)" as B

D --- UC15
D --- UC16
D --- UC17
C --- UC02
UC17 ..> UC16 : <<extend>>
UC19 ..> UC17 : <<extend>>
UC19 --> B : "correo de retraso\na cliente y operador"

note bottom of UC19
  Detalle: el sistema también puede marcar UC17
  solo (si la hora actual pasa el deadline sin
  entrega) y dispara UC19 sin intervención del
  domiciliario.
end note

legend right
  |= Símbolo |= Significado |
  | óvalo naranja | caso del domiciliario |
  | óvalo violeta | automático (sistema) |
  | «extend» | ocurre solo en esa condición |
endlegend

@enduml
