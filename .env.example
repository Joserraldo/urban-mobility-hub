# Copia a .env (no se sube a git)
VITE_DATA_SOURCE=mock
VITE_SITE_URL=https://urbanmobility.duckdns.org
# --- Servidor (en la VM van en /etc/umh/umh.env, nunca en git) ---
# Pagos Bold: sin BOLD_IDENTITY_KEY se usa la pasarela simulada.
# BOLD_IDENTITY_KEY=
# BOLD_SECRET_KEY=
# BOLD_ENV=test
# UMH_PUBLIC_URL=https://urbanmobility.duckdns.org
# Mapa: por defecto OpenStreetMap sin clave. Para otro proveedor (MapTiler, Stadia, Mapbox...):
# VITE_MAP_TILES_URL=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key={key}
# VITE_MAP_API_KEY=tu_clave
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
